# Optional local overrides for ops-sla-telemetry-lakehouse
# Never commit real credentials or private paths in .env

# Isolated output directory for real local C.O.R.E. multi-repo telemetry (ADR-003)
OST_CORE_TELEMETRY_DIR=../core/.logs/ops_sla_telemetry

# TickTick adapter defaults (POP_B_179; requires --execute --confirm for real writes)
OST_TICKTICK_DEFAULT_PROJECT=00_INBOX_AGENTES

# Dispatcher safety limit per execution run
OST_MAX_ALERTS_PER_RUN=10
